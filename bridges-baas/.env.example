# Bridges-as-a-Service Environment Configuration
# Copy this to .env and fill in the values

# ============================================
# CORE SETTINGS
# ============================================
NODE_ENV=production
PORT=3000

# Your domain (CHANGE THESE)
BASE_DOMAIN=yourdomain.com
MATRIX_SERVER_NAME=yourdomain.com
MATRIX_PUBLIC_URL=https://matrix.yourdomain.com
API_PUBLIC_URL=https://api.yourdomain.com
APP_URL=https://app.yourdomain.com

# ============================================
# DATABASE
# ============================================
POSTGRES_PASSWORD=change-me-to-secure-password
DATABASE_URL=postgres://matrix:${POSTGRES_PASSWORD}@postgres:5432/baas

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# SYNAPSE (Matrix Server)
# ============================================
SYNAPSE_URL=http://synapse:8008

# Generate with: docker exec -it matrix-synapse register_new_matrix_user -a -c /data/homeserver.yaml http://localhost:8008
# Then get token from Element: Settings > Help & About > Access Token
SYNAPSE_ADMIN_TOKEN=your-admin-access-token

# Generate with: openssl rand -hex 32
SYNAPSE_REGISTRATION_SECRET=generate-random-secret-here

# ============================================
# SECURITY
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-jwt-secret-here
CREDENTIAL_ENCRYPTION_KEY=generate-encryption-key-here
BRIDGE_WEBHOOK_SECRET=generate-webhook-secret-here

# ============================================
# TELEGRAM BRIDGE
# ============================================
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash

# ============================================
# SLACK BRIDGE (Optional - for OAuth flow)
# ============================================
# Create app at https://api.slack.com/apps
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# ============================================
# ADMIN
# ============================================
# Comma-separated list of admin emails
ADMIN_EMAILS=admin@yourdomain.com

# ============================================
# STRIPE (Optional - for payments)
# ============================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
